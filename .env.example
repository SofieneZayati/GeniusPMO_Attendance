# Local Expo development normally needs no HRMS IP configuration.
# When the phone opens this project from Expo on the same LAN, the app derives the PC address
# from the Expo development server and targets port 8000 automatically.
# Override only if your HRMS backend uses a different local port.
EXPO_PUBLIC_DEV_API_PORT=8000

# Production builds use one permanent public HRMS API URL.
# EXPO_PUBLIC_API_BASE_URL=https://api.your-domain.com/api/v1

# Fallback for unusual development setups (for example Expo tunnel or backend on another machine):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.25:8000/api/v1
